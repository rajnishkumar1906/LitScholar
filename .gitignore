# ===============================
# LitScholar - Global .gitignore
# ===============================

# --- Environment variables (CRITICAL) ---
.env
.env.*
**/ .env
**/ .env.*

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.venv/
venv/
ENV/
env/
Lib/
site-packages/

# --- Python tooling / cache ---
build/
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.cache/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# --- Logs ---
*.log
logs/

# --- ML Models Cache (Keep these ignored) ---
torch_cache/
sentence_transformers/
hf_cache/
huggingface/

# --- Frontend ---
node_modules/
dist/
build/
.next/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- VS Code / IDE ---
.vscode/
.idea/
.trae/

# --- Local Data & Temp ---
data/books_clean.csv
data/temp/
*.tmp
*.tiff
*.png~
*.jpg~

# --- Docker ---
docker-compose.override.yml
