# ===============================
# LitScholar - Global .gitignore
# ===============================

# --- Environment variables (CRITICAL) ---
.env
.env.*
**/.env
**/.env.*
.venv/
venv/
ENV/
env/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
Lib/
site-packages/
build/
dist/
downloads/
sdist/
var/
wheels/
pip-wheel-metadata/
.python-version

# --- Testing & Coverage ---
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.nox/
.tox/

# --- Jupyter Notebook ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# --- Frontend (React/Vite) ---
node_modules/
**/node_modules/
dist/
dist-ssr/
build/
*.local
.eslintcache
.stylelintcache
.parcel-cache
.next/
.nuxt/
.output/
.vercel/
.turbo/
.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- OS & IDE ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
!.vscode/extensions.json
.idea/
.trae/
*.sublime-project
*.sublime-workspace

# --- Logs ---
*.log
logs/
*.out

# --- ML Models & Large Assets ---
torch_cache/
sentence_transformers/
hf_cache/
huggingface/
models/
*.bin
*.pt
*.pth
*.onnx

# --- Local Data & Vector Stores ---
# Ignore local indices and databases that are generated
**/chroma_store/
**/faiss_store/
*.index
*.sqlite3
data/temp/
*.tmp

# --- Preprocessing & Scripts ---
FAISS_data_preprocessing/
data_processing/
create_books_schema.py
create_neon_schema.py
create_rag_schema.py
create_reset_table.py
pipeline_checks.py

# Allow specific raw data if needed, but ignore cleaned/temp versions
data/*.csv
!data/book_raw.csv
data/books_clean.csv

# --- Docker ---
docker-compose.override.yml
.docker/
